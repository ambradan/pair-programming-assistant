# LLM backends — at least one required.
# Priority: anthropic → nebius → gemini (first available wins, others used as fallback)

# Anthropic API key (direct REST, not OAuth)
# ANTHROPIC_API_KEY=sk-ant-api03-...

# Nebius AI Studio key (OpenAI-compatible endpoint, Kimi-K2.5)
# NEBIUS_API_KEY=...

# Google Gemini API key
# GEMINI_API_KEY=...

# Server port (default: 3001)
PPA_PORT=3001

# Environment — set to "development" for pretty logs
NODE_ENV=development
